APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=require

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------
# Mail
#
# LOCAL: keep MAIL_MAILER=log (verification codes are written to
#        storage/logs/laravel.log instead of being sent).
#
# PRODUCTION (Render): use Brevo via the official Symfony bridge over
#        its HTTPS API. Do NOT use SMTP — Render blocks outbound SMTP
#        ports 25/465/587.
#   Requires symfony/brevo-mailer + symfony/http-client; the brevo
#   transport is registered in AppServiceProvider and config/mail.php.
#   1. Create a free account at https://www.brevo.com (300 emails/day
#      free tier) and create an API key (v3):
#      https://app.brevo.com/settings/keys/api
#   2. Add and verify your sending domain (Senders, Domains & Dedicated
#      IPs). Without it you can only send from verified single sender
#      email addresses.
#   3. On the Render dashboard set:
#        MAIL_MAILER=brevo
#        BREVO_API_KEY=<your xkeysib-... API key>
#        MAIL_FROM_ADDRESS=<verified sender address or domain address>
#        MAIL_FROM_NAME=Egliane Accounting Services
# ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
